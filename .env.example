# Modèle du fichier .env (jamais versionné). Copier en .env et compléter ; aucune valeur réelle ici.

# Sentinel Hub (client OAuth créé sur le tableau de bord CDSE) : recherche des passages et analyses radar
SH_CLIENT_ID=
SH_CLIENT_SECRET=

# Base de données vue depuis le Mac (scripts) ; les conteneurs utilisent le nom de service "db"
DATABASE_URL=postgresql://mars:mars@localhost:5432/mars

# AISStream (collecte en direct, service collector) : une seule collecte par clé
AISSTREAM_API_KEY=

# Cloudflare R2 (service taches : archivage du Parquet et sauvegardes), serveur seulement
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Seau en juridiction européenne : https://<identifiant_du_compte>.eu.r2.cloudflarestorage.com
R2_ENDPOINT=https://<identifiant_du_compte>.r2.cloudflarestorage.com
R2_BUCKET=mars-c2

# Serveur seulement : surcouche Compose et profil du direct (collecte, ingestion, tâches)
# COMPOSE_FILE=docker-compose.yml:docker-compose.serveur.yml
# COMPOSE_PROFILES=direct

# Travailleurs éphémères Scaleway (étape 3, docs/deploiement.md et docs/travailleurs_viirs.md), serveur seulement
SCW_SECRET_KEY=
SCW_PROJECT_ID=
SCW_PRIVATE_NETWORK_ID=
SCW_SERVEUR_PRINCIPAL=
MARS_IP_PRIVEE=
# NASA Earthdata (VIIRS, lot B) : jeton valable 60 jours, licence LANCE NRT acceptée
EARTHDATA_TOKEN=
# Copernicus Data Space, accès S3 (Sentinel 1, lot C, docs/sentinel.md) : clés de
# https://eodata-s3keysmanager.dataspace.copernicus.eu ; gardées par le serveur, qui signe des adresses de lecture
CDSE_ACCESS_KEY=
CDSE_SECRET_KEY=
# Date d'expiration choisie à la création des clés (facultatif, lue par sentinel-diagnostic) : AAAA-MM-JJ
CDSE_CLES_EXPIRENT_LE=
