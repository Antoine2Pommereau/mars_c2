# Seuils de la supervision (étape D), dans un seul fichier : lus par Grafana (règles d'alerte,
# grafana/provisioning/alerting), par taches (alertes de secours, scripts/taches.py) et par les contrôles de
# santé de la collecte et de l'ingestion (scripts/sante.py). Un changement prend effet au redémarrage des
# services : docker compose up -d grafana taches collector ingest
# Pas de commentaire en fin de ligne (Compose et mars/config.py les garderaient dans la valeur).

# Disque : alerte sous ce pourcentage d'espace libre
SEUIL_DISQUE_LIBRE_PCT=15
# Disque : orange jusqu'à ce nombre de points au dessus du seuil d'alerte (tuile Disque de Grafana et indicateur Disque
# de la barre d'état de l'interface, qui montrent ainsi toujours la même couleur)
SEUIL_DISQUE_ORANGE_PTS=10
# Collecte : alerte, et redémarrage automatique, sans fichier Parquet écrit depuis ce nombre de minutes
SEUIL_COLLECTE_MIN=5
# Ingestion : alerte en échec ou en retard au delà de ce nombre de minutes
SEUIL_INGESTION_MIN=10
# VIIRS : alerte si la nuit précédente n'est pas traitée à cette heure (UTC)
HEURE_NUIT_VIIRS=8
# Tâches : alerte quand la même tâche échoue autant de fois de suite
ECHECS_SUCCESSIFS=2
# Collecteur OpenTelemetry (étape D2) : alerte quand plus aucun span n'est reçu depuis ce nombre de minutes
SEUIL_COLLECTEUR_MUET_MIN=15
