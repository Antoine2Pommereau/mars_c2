 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Collecteur : dernier span reçu",
   "description": "Minutes depuis le dernier relevé où le collecteur avait reçu de nouveaux spans. Alerte au delà de 15 minutes.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT extract(epoch FROM now() - max(mesure_le) FILTER (WHERE recus > prec)) / 60 AS minutes FROM (SELECT mesure_le, recus, lag(recus) OVER (ORDER BY mesure_le) AS prec FROM mesures_otel WHERE mesure_le > now() - interval '1 day') x WHERE EXISTS (SELECT 1 FROM mesures_otel WHERE mesure_le > now() - interval '30 minutes')"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "color": {
      "mode": "thresholds"
     },
     "noValue": "aucune mesure",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "#7c8b97"
       },
       {
        "value": 15,
        "color": "#ef6461"
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Spans refusés, 15 min",
   "description": "Spans refusés par le collecteur (mémoire saturée, file pleine). Alerte dès le premier.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT coalesce(sum(greatest(refuses - prec, 0)), 0) AS refus FROM (SELECT mesure_le, refuses, lag(refuses) OVER (ORDER BY mesure_le) AS prec FROM mesures_otel WHERE mesure_le > now() - interval '16 minutes') x WHERE mesure_le > now() - interval '15 minutes'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
     "noValue": "aucune mesure",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "#7c8b97"
       },
       {
        "value": 1,
        "color": "#ef6461"
       }
      ]
     },
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
