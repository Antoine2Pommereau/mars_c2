   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT 100.0 * count(*) FILTER (WHERE status <> 'nouvelle') / nullif(count(*), 0) AS part FROM alerts WHERE $__timeFilter(detected_at)"
