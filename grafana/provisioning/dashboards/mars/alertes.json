  {
   "id": 4,
   "type": "stat",
   "title": "Délai médian de première décision",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT percentile_cont(0.5) WITHIN GROUP (ORDER BY extract(epoch FROM x.premiere - a.detected_at)) AS delai FROM alerts a JOIN LATERAL (SELECT min(at) AS premiere FROM alert_actions WHERE alert_id = a.id) x ON x.premiere IS NOT NULL WHERE $__timeFilter(a.detected_at)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "thresholds"
     },
