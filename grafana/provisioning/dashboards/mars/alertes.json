      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT type AS \"Type\", count(*) AS \"Alertes\", count(*) FILTER (WHERE severity = 'elevee') AS \"Élevées\", count(*) FILTER (WHERE status <> 'nouvelle') AS \"Traitées\", round(100.0 * count(*) FILTER (WHERE status <> 'nouvelle') / count(*)) AS \"Part traitée\" FROM alerts WHERE $__timeFilter(detected_at) GROUP BY 1 ORDER BY 2 DESC"
    }
   ],
