  {
   "id": 6,
   "type": "timeseries",
   "title": "Cycle des règles par étape",
   "description": "Durée de chaque étape du cycle (deux jours gardés).",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT started_at AS time, e.k AS metric, e.v::float8 AS value FROM task_runs, jsonb_each_text(details->'durees_s') AS e(k, v) WHERE task = 'regles' AND $__timeFilter(started_at) ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "color": {
      "mode": "fixed",
      "fixedColor": "#4fb6c8"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "pointSize": 3,
      "showPoints": "never",
      "spanNulls": false,
      "axisBorderShow": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
