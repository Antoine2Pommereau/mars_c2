  {
   "id": 5,
   "type": "table",
   "title": "Dernière exécution de chaque tâche",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 24,
    "h": 10
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT DISTINCT ON (task) task AS \"Tâche\", status AS \"Statut\", started_at AS \"Début\", extract(epoch FROM finished_at - started_at) AS \"Durée\", left(coalesce(details->>'erreur', details->>'motif', ''), 160) AS \"Motif\", trace_id AS \"Trace\" FROM task_runs WHERE started_at > now() - interval '30 days' ORDER BY task, started_at DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#c2ccd3"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Trace"
      },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Ouvrir la trace dans Tempo (vue Gantt)",
          "url": "/explore?schemaVersion=1&orgId=1&panes=%7B%22a%22%3A%7B%22datasource%22%3A%22tempo%22%2C%22queries%22%3A%5B%7B%22refId%22%3A%22A%22%2C%22datasource%22%3A%7B%22type%22%3A%22tempo%22%2C%22uid%22%3A%22tempo%22%7D%2C%22queryType%22%3A%22traceql%22%2C%22query%22%3A%22${__value.raw}%22%7D%5D%2C%22range%22%3A%7B%22from%22%3A%22now-3d%22%2C%22to%22%3A%22now%22%7D%7D%7D"
         }
        ]
       },
       {
        "id": "custom.width",
        "value": 120
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Statut"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
