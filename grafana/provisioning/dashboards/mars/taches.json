  {
   "id": 4,
   "type": "stat",
   "title": "Tâches en échec deux fois de suite",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT count(*) AS taches FROM (SELECT task, array_agg(status ORDER BY started_at DESC) AS s FROM task_runs WHERE started_at > now() - interval '7 days' AND status <> 'en_cours' GROUP BY task) x WHERE s[1] = 'echec' AND s[2] = 'echec'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "thresholds"
     },
