  {
   "id": 3,
   "type": "stat",
   "title": "Durée du dernier cycle des règles",
   "description": "Le cycle revient toutes les 5 minutes.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT extract(epoch FROM finished_at - started_at) AS duree FROM task_runs WHERE task = 'regles' AND finished_at IS NOT NULL ORDER BY started_at DESC LIMIT 1"
