  {
   "id": 5,
   "type": "stat",
   "title": "Croissance par jour",
   "description": "Espace occupé gagné par jour, sur les sept derniers jours (purge et archivage compris).",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "WITH a AS (SELECT mesure_le, total_octets - libre_octets AS u FROM mesures_disque WHERE mesure_le > now() - interval '7 days' ORDER BY mesure_le LIMIT 1), b AS (SELECT mesure_le, total_octets - libre_octets AS u, libre_octets AS libre FROM mesures_disque ORDER BY mesure_le DESC LIMIT 1) SELECT (b.u - a.u) / (extract(epoch FROM b.mesure_le - a.mesure_le) / 86400) AS jour FROM a, b WHERE b.mesure_le - a.mesure_le > interval '6 hours'"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "color": {
      "mode": "thresholds"
     },
     "noValue": "moins de 6 h de mesures",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "value": null,
        "color": "#7c8b97"
       }
      ]
     },
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": "",
     "values": false
    },
    "colorMode": "value",
    "graphMode": "none",
    "textMode": "value",
    "justifyMode": "center",
    "wideLayout": true,
    "showPercentChange": false
   }
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Jours restants",
   "description": "Au rythme des sept derniers jours ; vide si l'occupation ne croît pas.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "WITH a AS (SELECT mesure_le, total_octets - libre_octets AS u FROM mesures_disque WHERE mesure_le > now() - interval '7 days' ORDER BY mesure_le LIMIT 1), b AS (SELECT mesure_le, total_octets - libre_octets AS u, libre_octets AS libre FROM mesures_disque ORDER BY mesure_le DESC LIMIT 1) SELECT CASE WHEN b.u > a.u THEN b.libre / ((b.u - a.u) / (extract(epoch FROM b.mesure_le - a.mesure_le) / 86400)) END AS jours FROM a, b WHERE b.mesure_le - a.mesure_le > interval '6 hours'"
    }
   ],
