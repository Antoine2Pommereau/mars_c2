  {
   "id": 9,
   "type": "timeseries",
   "title": "Croissance par jour",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "WITH d AS (SELECT DISTINCT ON (date_trunc('day', mesure_le)) date_trunc('day', mesure_le) AS jour, base_octets, positions_octets, total_octets - libre_octets AS occupe FROM mesures_disque WHERE $__timeFilter(mesure_le) ORDER BY date_trunc('day', mesure_le), mesure_le DESC) SELECT jour AS time, base_octets - lag(base_octets) OVER (ORDER BY jour) AS \"base\", positions_octets - lag(positions_octets) OVER (ORDER BY jour) AS \"positions\", occupe - lag(occupe) OVER (ORDER BY jour) AS \"disque occupé\" FROM d ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "decbytes",
     "color": {
      "mode": "fixed",
      "fixedColor": "#7c8b97"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "pointSize": 3,
      "showPoints": "never",
      "spanNulls": false,
      "axisBorderShow": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
