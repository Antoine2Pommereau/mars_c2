     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT coalesce(sum((mesures->>'cout_estime_eur')::float8), 0) AS cout FROM travailleurs WHERE tache = 'sentinel' AND cree_le >= date_trunc('month', now())"
