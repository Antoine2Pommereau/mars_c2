  {
   "id": 7,
   "type": "timeseries",
   "title": "Nuits VIIRS : détections par statut",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT g.nuit::timestamp AT TIME ZONE 'UTC' AS time, CASE WHEN d.mask_reason IS NOT NULL THEN 'écartées' WHEN d.non_evaluable IS NOT NULL THEN 'non évaluables' WHEN d.matched_vessel_id IS NOT NULL THEN 'avec AIS' ELSE 'sans AIS' END AS metric, count(*) AS value FROM viirs_detections d JOIN viirs_granules g ON g.id = d.granule_id WHERE g.nuit >= $__timeFrom()::date - 1 AND g.nuit <= $__timeTo()::date GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#7c8b97"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "pointSize": 3,
      "showPoints": "never",
      "spanNulls": false,
      "axisBorderShow": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "sans AIS"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e85bc7"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "avec AIS"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7c8b97"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "non évaluables"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#5a6b78"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "écartées"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3a4752"
        }
       }
      ]
     }
    ]
   },
   "options": {
