  {
   "id": 7,
   "type": "timeseries",
   "title": "Nuits VIIRS : détections par statut",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT g.nuit::timestamp AT TIME ZONE 'UTC' AS time, CASE WHEN d.mask_reason IS NOT NULL THEN 'écartées' WHEN d.non_evaluable IS NOT NULL THEN 'non évaluables' WHEN d.matched_vessel_id IS NOT NULL THEN 'avec AIS' ELSE 'sans AIS' END AS metric, count(*) AS value FROM viirs_detections d JOIN viirs_granules g ON g.id = d.granule_id WHERE g.nuit >= $__timeFrom()::date - 1 AND g.nuit <= $__timeTo()::date GROUP BY 1, 2 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#7c8b97"
     },
     "custom": {
      "drawStyle": "bars",
      "lineWidth": 1,
      "fillOpacity": 60,
      "pointSize": 3,
      "showPoints": "never",
      "spanNulls": false,
      "axisBorderShow": false,
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "sans AIS"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#e85bc7"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "avec AIS"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#7c8b97"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "non évaluables"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#5a6b78"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "écartées"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3a4752"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   }
  },
  {
   "id": 8,
   "type": "table",
   "title": "Nuits VIIRS",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT nuit AS \"Nuit\", count(*) AS \"Granules\", count(*) FILTER (WHERE erreur IS NOT NULL) AS \"En échec\", coalesce(sum(detections), 0) AS \"Détections\", max(traite_le) AS \"Traitée le\" FROM viirs_granules WHERE nuit >= $__timeFrom()::date - 1 GROUP BY 1 ORDER BY 1 DESC"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#c2ccd3"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
  },
  {
   "id": 9,
   "type": "table",
   "title": "Travailleurs",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 24,
    "h": 9
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT id AS \"N°\", tache AS \"Tâche\", etat AS \"État\", commercial_type AS \"Type\", cree_le AS \"Créé le\", extract(epoch FROM coalesce(detruit_le, now()) - cree_le) AS \"Durée\", coalesce(mesures->>'rss_max_mo', mesures->'mesures_travailleur'->>'rss_max_mo')::float8 AS \"Mémoire (Mo)\", (mesures->>'cout_estime_eur')::float8 AS \"Coût\", left(erreur, 160) AS \"Motif d'échec\" FROM travailleurs WHERE $__timeFilter(cree_le) ORDER BY id DESC LIMIT 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#c2ccd3"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "État"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "echec": {
            "text": "échec",
            "color": "#ef6461",
            "index": 0
           },
           "termine": {
            "text": "terminé",
            "color": "#7c8b97",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Durée"
      },
      "properties": [
       {
        "id": "unit",
        "value": "s"
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Coût"
      },
      "properties": [
       {
        "id": "unit",
        "value": "currencyEUR"
       }
      ]
     }
    ]
   },
   "options": {
