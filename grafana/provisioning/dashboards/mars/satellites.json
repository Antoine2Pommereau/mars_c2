  {
   "id": 8,
   "type": "table",
   "title": "Nuits VIIRS",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT nuit AS \"Nuit\", count(*) AS \"Granules\", count(*) FILTER (WHERE erreur IS NOT NULL) AS \"En échec\", coalesce(sum(detections), 0) AS \"Détections\", max(traite_le) AS \"Traitée le\" FROM viirs_granules WHERE nuit >= $__timeFrom()::date - 1 GROUP BY 1 ORDER BY 1 DESC"
    }
   ],
