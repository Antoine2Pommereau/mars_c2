  {
   "id": 2,
   "type": "stat",
   "title": "Part du budget Sentinel",
   "description": "Coût estimé du mois rapporté au budget de config/rules.yaml (sentinel.budget_mensuel_eur).",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT 100 * coalesce(sum(coalesce(cout_reel_eur, (mesures->>'cout_estime_eur')::float8)), 0) / nullif((SELECT valeur FROM parametres_supervision WHERE cle = 'budget_sentinel_eur'), 0) AS part FROM travailleurs WHERE tache = 'sentinel' AND cree_le >= date_trunc('month', now())"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "color": {
      "mode": "thresholds"
     },
     "noValue": "aucune mesure",
     "thresholds": {
      "mode": "absolute",
