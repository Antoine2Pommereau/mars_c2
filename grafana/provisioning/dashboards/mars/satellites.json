  {
   "id": 10,
   "type": "table",
   "title": "Passages Sentinel 1",
   "description": "",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 9
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT p.acquired_at AS \"Acquis le\", p.satellite AS \"Satellite\", p.statut AS \"État\", array_to_string(p.regions, ', ') AS \"Régions\", cardinality(p.infra_ids) AS \"Infrastructures\", cardinality(p.watch_ids) AS \"Navires des listes\", coalesce(a.status, 'non analysé') AS \"Analyse\" FROM sar_passes p LEFT JOIN LATERAL (SELECT status FROM analyses WHERE pass_id = p.id AND source = 'sentinel1' ORDER BY id DESC LIMIT 1) a ON true WHERE p.mission = 'S1' AND $__timeFilter(p.acquired_at) ORDER BY 1 DESC LIMIT 200"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#c2ccd3"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Analyse"
      },
      "properties": [
       {
        "id": "mappings",
        "value": [
         {
          "type": "value",
          "options": {
           "failed": {
            "text": "échec",
            "color": "#ef6461",
            "index": 0
           },
           "done": {
            "text": "analysé",
            "color": "#4fb6c8",
            "index": 1
           }
          }
         }
        ]
       },
       {
        "id": "custom.cellOptions",
        "value": {
         "type": "color-text"
        }
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
