   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT id AS \"N°\", tache AS \"Tâche\", etat AS \"État\", commercial_type AS \"Type\", cree_le AS \"Créé le\", extract(epoch FROM coalesce(detruit_le, now()) - cree_le) AS \"Durée\", coalesce(mesures->>'rss_max_mo', mesures->'mesures_travailleur'->>'rss_max_mo')::float8 AS \"Mémoire (Mo)\", cout_prevu_eur AS \"Coût prévu\", coalesce(cout_reel_eur, (mesures->>'cout_estime_eur')::float8) AS \"Coût réel\", CASE facturation WHEN 'minute' THEN 'à la minute' WHEN 'heure_entamee' THEN 'heure entamée' END AS \"Facturation\", left(erreur, 160) AS \"Motif d'échec\", trace_id AS \"Trace\" FROM travailleurs WHERE $__timeFilter(cree_le) ORDER BY id DESC LIMIT 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
