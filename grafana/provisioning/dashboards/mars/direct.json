  {
   "id": 5,
   "type": "timeseries",
   "title": "Messages par minute",
   "description": "Positions lues par minute de collecte (registre d'ingestion : les deux derniers jours, les journées archivées en sortent).",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "time_series",
     "rawSql": "SELECT $__timeGroupAlias(t, '1m', 0), sum(n) AS \"messages\" FROM ( SELECT to_timestamp(split_part(folder, 'date=', 2) || ' ' || left(name, 6), 'YYYY-MM-DD HH24MISS') ::timestamp AT TIME ZONE 'UTC' AS t, rows_read AS n FROM ingested_files WHERE ingested_at >= $__timeFrom() AND folder LIKE 'positions/%') f WHERE $__timeFilter(t) GROUP BY 1 ORDER BY 1"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "color": {
      "mode": "fixed",
      "fixedColor": "#4fb6c8"
     },
     "custom": {
      "drawStyle": "line",
      "lineWidth": 1,
      "fillOpacity": 8,
      "pointSize": 3,
      "showPoints": "never",
      "spanNulls": false,
      "axisBorderShow": false,
      "stacking": {
       "mode": "none",
       "group": "A"
      },
      "thresholdsStyle": {
       "mode": "off"
      }
     }
    },
    "overrides": []
