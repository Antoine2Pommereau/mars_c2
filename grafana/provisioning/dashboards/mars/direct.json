  {
   "id": 8,
   "type": "table",
   "title": "Coupures du flux",
   "description": "Minutes sous 20 % de la médiane de la période (définition de la frise de l'interface), trois minutes au moins.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "WITH bornes AS (SELECT greatest($__timeFrom()::timestamptz, min(minute)) AS a, least($__timeTo()::timestamptz, max(minute)) AS b FROM stats_minute WHERE minute <= $__timeTo()::timestamptz), m AS (SELECT g AS minute, coalesce(s.positions, 0) AS n FROM bornes, generate_series(date_trunc('minute', bornes.a), bornes.b, interval '1 minute') g LEFT JOIN stats_minute s ON s.minute = g), seuil AS (SELECT coalesce((SELECT valeur FROM parametres_supervision WHERE cle = 'ratio_coupure'), 0.2) * percentile_cont(0.5) WITHIN GROUP (ORDER BY n) AS v FROM m WHERE n > 0), c AS (SELECT minute, minute - row_number() OVER (ORDER BY minute) * interval '1 minute' AS grp FROM m, seuil WHERE n < seuil.v) SELECT min(minute) AS \"Début\", max(minute) + interval '1 minute' AS \"Fin\", count(*) AS \"Durée\" FROM c GROUP BY grp HAVING count(*) >= 3 ORDER BY 1 DESC LIMIT 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     },
     "color": {
      "mode": "fixed",
      "fixedColor": "#c2ccd3"
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "Durée"
      },
      "properties": [
       {
        "id": "unit",
        "value": "m"
       }
      ]
     }
    ]
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   }
