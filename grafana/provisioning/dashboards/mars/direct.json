   "type": "stat",
   "title": "Dernier fichier de la collecte",
   "description": "Minutes depuis le dernier fichier Parquet écrit (relevé chaque minute). Alerte et redémarrage automatique au delà de 5 minutes.",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "mars"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "transparent": true,
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "mars"
     },
     "editorMode": "code",
     "rawQuery": true,
     "format": "table",
     "rawSql": "SELECT extract(epoch FROM now() - dernier_le) / 60 AS minutes FROM signes_de_vie WHERE service = 'collecte'"
